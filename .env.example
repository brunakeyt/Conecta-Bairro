# Backend
DATABASE_URL=mysql+pymysql://usuario:senha@localhost/conecta_bairro
SECRET_KEY=chave-secreta-para-sessoes

# MySQL (used by Docker Compose)
MYSQL_ROOT_PASSWORD=senha
MYSQL_DATABASE=conecta_bairro

# Frontend
PUBLIC_API_BASE_URL=http://localhost:5000
PUBLIC_ENABLE_MOCK=false

# Duplicate this file as .env and fill in the real values.
# For local dev (no Docker): DATABASE_URL uses localhost.
# Docker Compose overrides DATABASE_URL automatically to use the db container.
